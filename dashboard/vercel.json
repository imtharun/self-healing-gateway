{
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://self-healing-gateway-api.onrender.com/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/operator",
      "destination": "/index.html"
    },
    {
      "source": "/operator/login",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
